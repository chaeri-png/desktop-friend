{
  "name": "baepsae-deskpet",
  "productName": "Desktop friend by chaeri",
  "version": "0.1.0",
  "description": "픽사 팀 데스크펫 — 뽀모도로와 하루 일과를 함께하는 뱁새",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.pixsa.baepsae-deskpet",
    "files": [
      "src/**",
      "characters/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.5",
    "three": "^0.185.1",
    "vitest": "^2.1.9"
  }
}
